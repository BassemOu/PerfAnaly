{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Next.js Dev Server",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": {
				"owner": "next",
				"pattern": {
					"regexp": "^(.*)$",
					"file": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*starting.*|.*compiling.*",
					"endsPattern": ".*ready.*|.*compiled.*|.*error.*"
				}
			},
			"group": "build"
		},
		{
			"label": "DB Push & Seed",
			"type": "shell",
			"command": "npx prisma db push && npx prisma db seed",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		}
	]
}